# COEP Scopus Live Dashboard - Production Release
# Elsevier Scopus API Configuration
# Obtain your free or institutional API key from https://dev.elsevier.com/
SCOPUS_API_KEY=YOUR_SCOPUS_API_KEY_HERE

# Optional: Elsevier Institutional Token (if provided by COEP library / institutional subscription)
SCOPUS_INST_TOKEN=

# Affiliation Search Query or Scopus Affiliation ID for COEP
# Scopus Affiliation ID for College of Engineering Pune / COEP Tech University is 60009476
SCOPUS_AFFIL_QUERY=AF-ID(60009476) OR AFFIL({COEP Technological University}) OR AFFIL({College of Engineering Pune}) OR AFFIL({College of Engineering Poona}) OR AFFIL({COEP Pune}) OR AFFIL({COEP Tech})
SCOPUS_AFFIL_ID=60009476

# Cache and Sync Settings
CACHE_FILE=data/coep_scopus_cache.json
MAX_PAPERS_TO_FETCH=2000

# Optional: Google Gemini API Key for AI Research Copilot Chatbot (Free from https://aistudio.google.com/)
GEMINI_API_KEY=
